{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mjs",
      "**/*.json",
      "!**/dist",
      "!**/artifacts",
      "!**/.next",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/with-en-gb/src/hyphenation.json",
        "packages/with-es-es/src/hyphenation.json"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
