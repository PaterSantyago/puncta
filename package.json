{
  "name": "puncta-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "format:check": "biome format . && prettier --check '**/*.{md,yml,yaml}'",
    "format": "biome format --write . && prettier --write '**/*.{md,yml,yaml}'",
    "typecheck": "tsc --noEmit && pnpm --filter puncta-example-ssr typecheck",
    "build": "pnpm -r build",
    "test:install": "node scripts/install.mjs",
    "test": "pnpm test:release && pnpm test:publish && pnpm test:install",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm pack:check && pnpm test && node scripts/release.mjs validate",
    "pack:check": "node scripts/pack.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "test:publish": "node --test scripts/publish.test.mjs",
    "release:publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/react": "19.3.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "semver": "7.7.4",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "verdaccio": "6.10.3"
  }
}
